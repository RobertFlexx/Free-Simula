integer function Add(left: integer, right: integer): integer;
begin
    return left + right
end;

program PascalHybrid;
begin
    var index: integer := 0;
    var answer: integer;
    repeat
        index := index + 1
    until index = 2;
    case index of
        2: answer := Add(40, index)
    end;
    assert(answer = 42)
end;
