Class Base;
Virtual: Procedure Execute Is Procedure Execute;;
begin
    Private:
    integer secret;
    Protected:
    integer state;
    Public:
    Procedure Execute;
    begin
        state := state + 1
    end;
end;

Base Class Derived;
begin
    Public:
    Procedure Execute;
    begin
        state := state + 2
    end;
end;

program VisibilityVirtual;
begin
    Ref(Base) item;
    item :- new Derived();
    item.Execute()
end;
