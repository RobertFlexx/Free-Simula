! riftline 1.1.3 -- arena survival for Free Simula 1.6.1 + raylib;

program Riftline;


foreign c record Vector2 begin
    x: c_float;
    y: c_float;
end;

foreign c record Rectangle begin
    x: c_float;
    y: c_float;
    width: c_float;
    height: c_float;
end;

foreign c record Color begin
    r: c_uchar;
    g: c_uchar;
    b: c_uchar;
    a: c_uchar;
end;

foreign c from "libraylib.so" begin
    procedure SetConfigFlags(flags: c_uint);
    procedure InitWindow(width: c_int, height: c_int, title: c_string);
    procedure CloseWindow();
    function WindowShouldClose(): c_bool;
    procedure SetTargetFPS(fps: c_int);
    function GetFrameTime(): c_float;
    function GetTime(): c_double;

    function IsKeyDown(key: c_int): c_bool;
    function IsKeyPressed(key: c_int): c_bool;
    function IsMouseButtonDown(button: c_int): c_bool;
    function IsMouseButtonPressed(button: c_int): c_bool;
    function GetMousePosition(): Vector2;

    function GetRandomValue(minimum: c_int, maximum: c_int): c_int;

    procedure BeginDrawing();
    procedure EndDrawing();
    procedure ClearBackground(color: Color);

    procedure DrawCircleV(center: Vector2, radius: c_float, color: Color);
    procedure DrawCircleLines(centerX: c_int, centerY: c_int, radius: c_float, color: Color);
    procedure DrawCircleGradient(centerX: c_int, centerY: c_int, radius: c_float,
                                 inside_color: Color, outside_color: Color);
    procedure DrawRectangle(x: c_int, y: c_int, width: c_int, height: c_int, color: Color);
    procedure DrawRectangleRec(rec: Rectangle, color: Color);
    procedure DrawRectangleRounded(rec: Rectangle, roundness: c_float,
                                   segments: c_int, color: Color);
    procedure DrawRectangleRoundedLinesEx(rec: Rectangle, roundness: c_float,
                                          segments: c_int, lineThick: c_float, color: Color);
    procedure DrawLineEx(startPos: Vector2, endPos: Vector2,
                         thick: c_float, color: Color);
    procedure DrawTriangle(v1: Vector2, v2: Vector2, v3: Vector2, color: Color);
    procedure DrawRing(center: Vector2, innerRadius: c_float, outerRadius: c_float,
                       startAngle: c_float, endAngle: c_float,
                       segments: c_int, color: Color);

    procedure DrawText(glyph_text: c_string, posX: c_int, posY: c_int,
                       fontSize: c_int, color: Color);
    function MeasureText(glyph_text: c_string, fontSize: c_int): c_int;
    function TextFormat(format_text: c_string, ...): c_string;
    procedure DrawFPS(posX: c_int, posY: c_int);
end;

foreign c from "libm.so.6" begin
    function c_sqrt(x: c_double): c_double = "sqrt";
    function c_sin(x: c_double): c_double = "sin";
    function c_cos(x: c_double): c_double = "cos";
end;

const integer ScreenWidth = 1280;
const integer ScreenHeight = 720;
const integer MaxEnemies = 72;
const integer MaxBullets = 192;
const integer MaxParticles = 420;
const integer KeyW = 87;
const integer KeyA = 65;
const integer KeyS = 83;
const integer KeyD = 68;
const integer KeyP = 80;
const integer KeyR = 82;
const integer KeyEnter = 257;
const integer KeyOne = 49;
const integer KeyTwo = 50;
const integer KeyThree = 51;
const integer KeySpace = 32;
const integer MouseLeft = 0;
const integer FlagMsaa4x = 32;

Color function Rgba(integer red, integer green, integer blue, integer alpha);
begin
    Color c;
    c.r := c_uchar(red);
    c.g := c_uchar(green);
    c.b := c_uchar(blue);
    c.a := c_uchar(alpha);
    return c
end;

Vector2 function Vec(real vx, real vy);
begin
    Vector2 v;
    v.x := c_float(vx);
    v.y := c_float(vy);
    return v
end;

Rectangle function Rect(real rx, real ry, real rw, real rh);
begin
    Rectangle r;
    r.x := c_float(rx);
    r.y := c_float(ry);
    r.width := c_float(rw);
    r.height := c_float(rh);
    return r
end;

real function Root(real x);
begin
    if x <= 0.0 then
        return 0.0;
    return real(c_sqrt(c_double(x)))
end;

real function Sin(real x);
begin
    return real(c_sin(c_double(x)))
end;

real function Cos(real x);
begin
    return real(c_cos(c_double(x)))
end;

real function Clamp(real x, real lower_bound, real upper_bound);
begin
    if x < lower_bound then
        return lower_bound;
    if x > upper_bound then
        return upper_bound;
    return x
end;

real function DistanceSquared(real ax, real ay, real bx, real by);
begin
    real dx;
    real dy;
    dx := ax - bx;
    dy := ay - by;
    return dx * dx + dy * dy
end;

real function RandomReal(integer lower_bound, integer upper_bound);
begin
    return real(GetRandomValue(c_int(lower_bound), c_int(upper_bound)))
end;


! Fixed value pools. Startup avoids hundreds of heap allocations;
array[1:72] boolean enemy_active;
array[1:72] integer enemy_kind;
array[1:72] real enemy_x;
array[1:72] real enemy_y;
array[1:72] real enemy_vx;
array[1:72] real enemy_vy;
array[1:72] real enemy_radius;
array[1:72] real enemy_speed;
array[1:72] integer enemy_hp;
array[1:72] integer enemy_max_hp;
array[1:72] real enemy_touch_delay;
array[1:72] real enemy_phase;

array[1:192] boolean bullet_active;
array[1:192] real bullet_x;
array[1:192] real bullet_y;
array[1:192] real bullet_old_x;
array[1:192] real bullet_old_y;
array[1:192] real bullet_vx;
array[1:192] real bullet_vy;
array[1:192] real bullet_life;
array[1:192] real bullet_radius;
array[1:192] integer bullet_damage;

array[1:420] boolean particle_active;
array[1:420] real particle_x;
array[1:420] real particle_y;
array[1:420] real particle_vx;
array[1:420] real particle_vy;
array[1:420] real particle_life;
array[1:420] real particle_max_life;
array[1:420] real particle_size;
array[1:420] integer particle_color_kind;

real player_x;
real player_y;
real aim_x;
real aim_y;
real fire_wait;
real dash_wait;
real dash_time;
real hurt_time;
integer health;
integer max_health;
integer score;
integer best_score;
integer wave;
integer wave_kills;
integer total_kills;
integer combo;
real combo_time;
real spawn_wait;
integer fire_level;
integer move_level;
integer damage_level;
integer bosses_killed;
boolean started;
boolean paused;
boolean game_over;
boolean upgrade_pending;
boolean boss_spawned;
real shake_time;
real shake_power;
boolean core_active;
real core_x;
real core_y;
real core_phase;

Procedure Init;
begin
    integer i;

    player_x := 640.0;
    player_y := 360.0;
    aim_x := 1.0;
    aim_y := 0.0;
    fire_wait := 0.0;
    dash_wait := 0.0;
    dash_time := 0.0;
    hurt_time := 0.0;
    max_health := 100;
    health := max_health;
    score := 0;
    best_score := 0;
    wave := 1;
    wave_kills := 0;
    total_kills := 0;
    combo := 0;
    combo_time := 0.0;
    spawn_wait := 0.25;
    fire_level := 0;
    move_level := 0;
    damage_level := 0;
    bosses_killed := 0;
    started := false;
    paused := false;
    game_over := false;
    upgrade_pending := false;
    boss_spawned := false;
    shake_time := 0.0;
    shake_power := 0.0;
    core_active := false;
    core_x := 0.0;
    core_y := 0.0;
    core_phase := 0.0;

    for i := 1 step 1 until MaxEnemies do enemy_active[i] := false;
    for i := 1 step 1 until MaxBullets do bullet_active[i] := false;
    for i := 1 step 1 until MaxParticles do particle_active[i] := false
end;

Procedure Restart;
begin
    integer i;

    player_x := 640.0;
    player_y := 360.0;
    fire_wait := 0.0;
    dash_wait := 0.0;
    dash_time := 0.0;
    hurt_time := 0.0;
    max_health := 100;
    health := max_health;
    score := 0;
    wave := 1;
    wave_kills := 0;
    total_kills := 0;
    combo := 0;
    combo_time := 0.0;
    spawn_wait := 0.4;
    fire_level := 0;
    move_level := 0;
    damage_level := 0;
    bosses_killed := 0;
    started := true;
    paused := false;
    game_over := false;
    upgrade_pending := false;
    boss_spawned := false;
    shake_time := 0.0;
    shake_power := 0.0;
    core_active := false;

    for i := 1 step 1 until MaxEnemies do
        enemy_active[i] := false;
    for i := 1 step 1 until MaxBullets do
        bullet_active[i] := false;
    for i := 1 step 1 until MaxParticles do
        particle_active[i] := false
end;


Procedure Burst(real px, real py, integer count, integer color_kind,
                real speed_low, real speed_high);
begin
    integer i;
    integer slot;
    integer attempt;
    real angle;
    real speed;

    for i := 1 step 1 until count do
    begin
        slot := 0;
        attempt := 1;
        while (attempt <= MaxParticles) and (slot = 0) do
        begin
            if not particle_active[attempt] then
                slot := attempt
            else
                attempt := attempt + 1
        end;

        if slot > 0 then
        begin
                angle := RandomReal(0, 6283) / 1000.0;
            speed := RandomReal(integer(speed_low), integer(speed_high));
            particle_active[slot] := true;
            particle_x[slot] := px;
            particle_y[slot] := py;
            particle_vx[slot] := Cos(angle) * speed;
            particle_vy[slot] := Sin(angle) * speed;
            particle_life[slot] := RandomReal(22, 62) / 100.0;
            particle_max_life[slot] := particle_life[slot];
            particle_size[slot] := RandomReal(2, 6);
            particle_color_kind[slot] := color_kind
        end
    end
end;


Procedure SpawnEnemy;
begin
    integer i;
    integer slot;
    integer side;
    integer roll;

    slot := 0;
    i := 1;
    while (i <= MaxEnemies) and (slot = 0) do
    begin
        if not enemy_active[i] then
            slot := i
        else
            i := i + 1
    end;

    if slot = 0 then
        return;

    side := integer(GetRandomValue(c_int(0), c_int(3)));
    if side = 0 then
    begin
        enemy_x[slot] := -40.0;
        enemy_y[slot] := RandomReal(40, ScreenHeight - 40)
    end
    else if side = 1 then
    begin
        enemy_x[slot] := real(ScreenWidth) + 40.0;
        enemy_y[slot] := RandomReal(40, ScreenHeight - 40)
    end
    else if side = 2 then
    begin
        enemy_x[slot] := RandomReal(40, ScreenWidth - 40);
        enemy_y[slot] := -40.0
    end
    else
    begin
        enemy_x[slot] := RandomReal(40, ScreenWidth - 40);
        enemy_y[slot] := real(ScreenHeight) + 40.0
    end;

    roll := integer(GetRandomValue(c_int(0), c_int(99)));
    if (wave mod 5 = 0) and (not boss_spawned) then
    begin
        enemy_kind[slot] := 3;
        boss_spawned := true
    end
    else if (wave >= 3) and (roll < 18) then
        enemy_kind[slot] := 2
    else if (wave >= 2) and (roll < 42) then
        enemy_kind[slot] := 1
    else
        enemy_kind[slot] := 0;

    if enemy_kind[slot] = 0 then
    begin
        enemy_radius[slot] := 14.0;
        enemy_speed[slot] := 112.0 + real(wave) * 3.5;
        enemy_max_hp[slot] := 1 + wave // 7
    end
    else if enemy_kind[slot] = 1 then
    begin
        enemy_radius[slot] := 23.0;
        enemy_speed[slot] := 64.0 + real(wave) * 2.0;
        enemy_max_hp[slot] := 3 + wave // 3
    end
    else if enemy_kind[slot] = 2 then
    begin
        enemy_radius[slot] := 17.0;
        enemy_speed[slot] := 88.0 + real(wave) * 2.8;
        enemy_max_hp[slot] := 2 + wave // 4
    end
    else
    begin
        enemy_radius[slot] := 39.0;
        enemy_speed[slot] := 52.0 + real(wave) * 1.2;
        enemy_max_hp[slot] := 18 + wave * 4
    end;

    enemy_hp[slot] := enemy_max_hp[slot];
    enemy_vx[slot] := 0.0;
    enemy_vy[slot] := 0.0;
    enemy_touch_delay[slot] := 0.0;
    enemy_phase[slot] := RandomReal(0, 6283) / 1000.0;
    enemy_active[slot] := true
end;


Procedure Shoot;
begin
    integer i;
    integer slot;
    real len;
    real dx;
    real dy;

    slot := 0;
    i := 1;
    while (i <= MaxBullets) and (slot = 0) do
    begin
        if not bullet_active[i] then
            slot := i
        else
            i := i + 1
    end;
    if slot = 0 then
        return;

    dx := aim_x;
    dy := aim_y;
    len := Root(dx * dx + dy * dy);
    if len < 0.001 then
        return;

    dx := dx / len;
    dy := dy / len;

    bullet_active[slot] := true;
    bullet_x[slot] := player_x + dx * 22.0;
    bullet_y[slot] := player_y + dy * 22.0;
    bullet_old_x[slot] := bullet_x[slot];
    bullet_old_y[slot] := bullet_y[slot];
    bullet_vx[slot] := dx * 790.0;
    bullet_vy[slot] := dy * 790.0;
    bullet_life[slot] := 1.05;
    bullet_radius[slot] := 4.0;
    bullet_damage[slot] := 1 + damage_level;

    Burst(bullet_x[slot], bullet_y[slot], 2, 0, 35.0, 90.0)
end;


Procedure HitPlayer(real from_x, real from_y);
begin
    real dx;
    real dy;
    real len;

    if hurt_time > 0.0 then
        return;
    if dash_time > 0.0 then
        return;

    health := health - 18;
    hurt_time := 0.65;
    combo := 0;
    combo_time := 0.0;
    shake_time := 0.22;
    shake_power := 10.0;

    dx := player_x - from_x;
    dy := player_y - from_y;
    len := Root(dx * dx + dy * dy);
    if len > 0.001 then
    begin
        player_x := player_x + dx / len * 20.0;
        player_y := player_y + dy / len * 20.0
    end;

    Burst(player_x, player_y, 24, 2, 80.0, 260.0);

    if health <= 0 then
    begin
        health := 0;
        if score > best_score then best_score := score;
        game_over := true;
        Burst(player_x, player_y, 70, 2, 90.0, 360.0)
    end
end;


Procedure EnemyKilled(integer enemy_index);
begin
    integer bonus;

    enemy_active[enemy_index] := false;
    total_kills := total_kills + 1;
    wave_kills := wave_kills + 1;
    combo := combo + 1;
    combo_time := 2.4;

    bonus := 100;
    if enemy_kind[enemy_index] = 1 then
        bonus := 240
    else if enemy_kind[enemy_index] = 2 then
        bonus := 175
    else if enemy_kind[enemy_index] = 3 then
    begin
        bonus := 3200 + wave * 250;
        bosses_killed := bosses_killed + 1
    end;

    score := score + bonus * (1 + combo // 5);
    shake_time := 0.10;
    shake_power := 4.0 + enemy_radius[enemy_index] * 0.12;
    Burst(enemy_x[enemy_index], enemy_y[enemy_index], 16 + enemy_kind[enemy_index] * 7, 1 + enemy_kind[enemy_index], 55.0, 245.0);

    if ((total_kills mod 10 = 0) or (enemy_kind[enemy_index] = 3)) and (not core_active) then
    begin
        core_active := true;
        core_x := enemy_x[enemy_index];
        core_y := enemy_y[enemy_index];
        core_phase := 0.0
    end;

    if wave_kills >= 10 + wave * 3 then
    begin
        wave := wave + 1;
        wave_kills := 0;
        score := score + wave * 300;
        boss_spawned := false;
        upgrade_pending := true;
        Burst(player_x, player_y, 34, 0, 80.0, 280.0)
    end
end;


Procedure Update(real dt);
begin
    integer i;
    integer j;
    real move_x;
    real move_y;
    real move_len;
    real speed;
    real dx;
    real dy;
    real dist;
    real dist_sq;
    real nx;
    real ny;
    real tangent_x;
    real tangent_y;
    real now;
    real spawn_rate;
    Vector2 mouse;

    if not started then
    begin
        if IsKeyPressed(c_int(KeyEnter)) <> c_bool(0) then
            Restart();
        return
    end;

    if game_over then
    begin
        if IsKeyPressed(c_int(KeyR)) <> c_bool(0) then
            Restart();
        return
    end;

    if upgrade_pending then
    begin
        if IsKeyPressed(c_int(KeyOne)) <> c_bool(0) then
        begin
            fire_level := fire_level + 1;
            upgrade_pending := false
        end
        else if IsKeyPressed(c_int(KeyTwo)) <> c_bool(0) then
        begin
            move_level := move_level + 1;
            upgrade_pending := false
        end
        else if IsKeyPressed(c_int(KeyThree)) <> c_bool(0) then
        begin
            damage_level := damage_level + 1;
            max_health := max_health + 10;
            health := health + 24;
            if health > max_health then health := max_health;
            upgrade_pending := false
        end;

        if not upgrade_pending then
        begin
            score := score + 250;
            Burst(player_x, player_y, 28, 4, 70.0, 240.0)
        end;
        return
    end;

    if IsKeyPressed(c_int(KeyP)) <> c_bool(0) then
        paused := not paused;

    if paused then
        return;

    if fire_wait > 0.0 then fire_wait := fire_wait - dt;
    if dash_wait > 0.0 then dash_wait := dash_wait - dt;
    if dash_time > 0.0 then dash_time := dash_time - dt;
    if hurt_time > 0.0 then hurt_time := hurt_time - dt;
    if shake_time > 0.0 then shake_time := shake_time - dt;

    if combo_time > 0.0 then
    begin
        combo_time := combo_time - dt;
        if combo_time <= 0.0 then
            combo := 0
    end;

    move_x := 0.0;
    move_y := 0.0;
    if IsKeyDown(c_int(KeyW)) <> c_bool(0) then move_y := move_y - 1.0;
    if IsKeyDown(c_int(KeyS)) <> c_bool(0) then move_y := move_y + 1.0;
    if IsKeyDown(c_int(KeyA)) <> c_bool(0) then move_x := move_x - 1.0;
    if IsKeyDown(c_int(KeyD)) <> c_bool(0) then move_x := move_x + 1.0;

    move_len := Root(move_x * move_x + move_y * move_y);
    if move_len > 0.001 then
    begin
        move_x := move_x / move_len;
        move_y := move_y / move_len
    end;

    if (IsKeyPressed(c_int(KeySpace)) <> c_bool(0)) and
       (dash_wait <= 0.0) and (move_len > 0.001) then
    begin
        dash_time := 0.15;
        dash_wait := 1.0;
        shake_time := 0.12;
        shake_power := 3.0;
        Burst(player_x, player_y, 18, 0, 45.0, 175.0)
    end;

    speed := 330.0 + real(move_level) * 24.0;
    if dash_time > 0.0 then speed := 920.0;
    player_x := Clamp(player_x + move_x * speed * dt, 24.0, real(ScreenWidth) - 24.0);
    player_y := Clamp(player_y + move_y * speed * dt, 24.0, real(ScreenHeight) - 24.0);

    mouse := GetMousePosition();
    aim_x := real(mouse.x) - player_x;
    aim_y := real(mouse.y) - player_y;

    if (IsMouseButtonDown(c_int(MouseLeft)) <> c_bool(0)) and (fire_wait <= 0.0) then
    begin
        Shoot();
        fire_wait := 0.095 - real(fire_level) * 0.010;
        if fire_wait < 0.042 then fire_wait := 0.042
    end;

    spawn_wait := spawn_wait - dt;
    if spawn_wait <= 0.0 then
    begin
        SpawnEnemy();
        spawn_rate := 0.78 - real(wave) * 0.035;
        if spawn_rate < 0.18 then spawn_rate := 0.18;
        spawn_wait := spawn_rate
    end;

    i := 1;
    while i <= MaxBullets do
    begin
        if bullet_active[i] then
        begin
            bullet_old_x[i] := bullet_x[i];
            bullet_old_y[i] := bullet_y[i];
            bullet_x[i] := bullet_x[i] + bullet_vx[i] * dt;
            bullet_y[i] := bullet_y[i] + bullet_vy[i] * dt;
            bullet_life[i] := bullet_life[i] - dt;

            if (bullet_life[i] <= 0.0) or (bullet_x[i] < -30.0) or
               (bullet_x[i] > real(ScreenWidth) + 30.0) or
               (bullet_y[i] < -30.0) or (bullet_y[i] > real(ScreenHeight) + 30.0) then
                bullet_active[i] := false
            else
            begin
                j := 1;
                while (j <= MaxEnemies) and bullet_active[i] do
                begin
                    if enemy_active[j] then
                    begin
                        dist_sq := DistanceSquared(bullet_x[i], bullet_y[i], enemy_x[j], enemy_y[j]);
                        if dist_sq <= (bullet_radius[i] + enemy_radius[j]) * (bullet_radius[i] + enemy_radius[j]) then
                        begin
                            bullet_active[i] := false;
                            enemy_hp[j] := enemy_hp[j] - bullet_damage[i];
                            Burst(bullet_x[i], bullet_y[i], 7, 0, 55.0, 190.0);
                            if enemy_hp[j] <= 0 then
                                EnemyKilled(j)
                            else
                            begin
                                shake_time := 0.04;
                                shake_power := 1.5
                            end
                        end
                    end;
                    j := j + 1
                end
            end
        end;
        i := i + 1
    end;

    now := real(GetTime());
    i := 1;
    while i <= MaxEnemies do
    begin
        if enemy_active[i] then
        begin
            if enemy_touch_delay[i] > 0.0 then
                enemy_touch_delay[i] := enemy_touch_delay[i] - dt;

            dx := player_x - enemy_x[i];
            dy := player_y - enemy_y[i];
            dist := Root(dx * dx + dy * dy);
            if dist > 0.001 then
            begin
                nx := dx / dist;
                ny := dy / dist
            end
            else
            begin
                nx := 0.0;
                ny := 0.0
            end;

            if enemy_kind[i] = 2 then
            begin
                tangent_x := -ny;
                tangent_y := nx;
                enemy_vx[i] := nx * enemy_speed[i] + tangent_x * Sin(now * 3.0 + enemy_phase[i]) * 95.0;
                enemy_vy[i] := ny * enemy_speed[i] + tangent_y * Sin(now * 3.0 + enemy_phase[i]) * 95.0
            end
            else if enemy_kind[i] = 3 then
            begin
                tangent_x := -ny;
                tangent_y := nx;
                enemy_vx[i] := nx * (enemy_speed[i] + 28.0 * (0.5 + 0.5 * Sin(now * 1.7))) +
                        tangent_x * Sin(now * 1.3 + enemy_phase[i]) * 52.0;
                enemy_vy[i] := ny * (enemy_speed[i] + 28.0 * (0.5 + 0.5 * Sin(now * 1.7))) +
                        tangent_y * Sin(now * 1.3 + enemy_phase[i]) * 52.0
            end
            else
            begin
                enemy_vx[i] := nx * enemy_speed[i];
                enemy_vy[i] := ny * enemy_speed[i]
            end;

            enemy_x[i] := enemy_x[i] + enemy_vx[i] * dt;
            enemy_y[i] := enemy_y[i] + enemy_vy[i] * dt;

            if dist <= enemy_radius[i] + 17.0 then
            begin
                HitPlayer(enemy_x[i], enemy_y[i]);
                enemy_touch_delay[i] := 0.45
            end
        end;
        i := i + 1
    end;

    if core_active then
    begin
        core_phase := core_phase + dt * 3.0;
        if DistanceSquared(player_x, player_y, core_x, core_y) < 34.0 * 34.0 then
        begin
            core_active := false;
            health := health + 24;
            if health > max_health then health := max_health;
            score := score + 500;
            Burst(core_x, core_y, 30, 4, 75.0, 260.0)
        end
    end;

    i := 1;
    while i <= MaxParticles do
    begin
        if particle_active[i] then
        begin
            particle_life[i] := particle_life[i] - dt;
            if particle_life[i] <= 0.0 then
                particle_active[i] := false
            else
            begin
                particle_x[i] := particle_x[i] + particle_vx[i] * dt;
                particle_y[i] := particle_y[i] + particle_vy[i] * dt;
                particle_vx[i] := particle_vx[i] * (1.0 - 2.8 * dt);
                particle_vy[i] := particle_vy[i] * (1.0 - 2.8 * dt)
            end
        end;
        i := i + 1
    end
end;


Procedure Draw;
begin
    integer i;
    integer gx;
    integer gy;
    integer hp_width;
    integer enemy_hp_width;
    integer boss_hp;
    integer boss_max_hp;
    integer title_width;
    boolean boss_visible;
    real now;
    real pulse;
    real alpha_scale;
    real aim_len;
    real dx;
    real dy;
    real nx;
    real ny;
    real sx;
    real sy;
    real shake_x;
    real shake_y;
    Vector2 a;
    Vector2 b;
    Vector2 c;
    Vector2 center;
    Rectangle panel;
    Color enemy_color;
    Color particle_color;

    now := real(GetTime());
    boss_visible := false;
    boss_hp := 0;
    boss_max_hp := 1;
    shake_x := 0.0;
    shake_y := 0.0;
    if shake_time > 0.0 then
    begin
        shake_x := RandomReal(-100, 100) / 100.0 * shake_power;
        shake_y := RandomReal(-100, 100) / 100.0 * shake_power
    end;

    BeginDrawing();
    ClearBackground(Rgba(6, 8, 16, 255));

    gx := -40;
    while gx <= ScreenWidth + 40 do
    begin
        a := Vec(real(gx) + shake_x, shake_y);
        b := Vec(real(gx) + shake_x, real(ScreenHeight) + shake_y);
        DrawLineEx(a, b, c_float(1.0), Rgba(16, 31, 49, 110));
        gx := gx + 40
    end;
    gy := -40;
    while gy <= ScreenHeight + 40 do
    begin
        a := Vec(shake_x, real(gy) + shake_y);
        b := Vec(real(ScreenWidth) + shake_x, real(gy) + shake_y);
        DrawLineEx(a, b, c_float(1.0), Rgba(16, 31, 49, 110));
        gy := gy + 40
    end;

    center := Vec(real(ScreenWidth) * 0.5 + shake_x, real(ScreenHeight) * 0.5 + shake_y);
    pulse := 0.5 + Sin(now * 1.6) * 0.5;
    DrawRing(center, c_float(265.0 + pulse * 12.0), c_float(266.0 + pulse * 12.0),
             c_float(0.0), c_float(360.0), c_int(96), Rgba(22, 57, 84, 95));
    DrawRing(center, c_float(430.0 + pulse * 18.0), c_float(431.0 + pulse * 18.0),
             c_float(0.0), c_float(360.0), c_int(128), Rgba(16, 41, 68, 75));

    if not started then
    begin
        DrawRectangle(c_int(0), c_int(0), c_int(ScreenWidth), c_int(ScreenHeight), Rgba(2, 5, 12, 92));
        title_width := integer(MeasureText("RIFTLINE", c_int(72)));
        DrawText("RIFTLINE", c_int((ScreenWidth - title_width) // 2), c_int(196), c_int(72), Rgba(204, 250, 255, 255));
        title_width := integer(MeasureText("SURVIVE THE SIGNAL STORM", c_int(22)));
        DrawText("SURVIVE THE SIGNAL STORM", c_int((ScreenWidth - title_width) // 2), c_int(286), c_int(22), Rgba(79, 215, 255, 255));
        title_width := integer(MeasureText("ENTER TO JACK IN", c_int(28)));
        DrawText("ENTER TO JACK IN", c_int((ScreenWidth - title_width) // 2), c_int(390), c_int(28), Rgba(255, 187, 72, 255));
        title_width := integer(MeasureText("WASD move  /  mouse aim  /  LMB fire  /  SPACE dash", c_int(17)));
        DrawText("WASD move  /  mouse aim  /  LMB fire  /  SPACE dash", c_int((ScreenWidth - title_width) // 2), c_int(452), c_int(17), Rgba(143, 171, 194, 255));
        title_width := integer(MeasureText("Every cleared wave gives you a permanent run upgrade. Every fifth wave wakes a Titan.", c_int(15)));
        DrawText("Every cleared wave gives you a permanent run upgrade. Every fifth wave wakes a Titan.", c_int((ScreenWidth - title_width) // 2), c_int(488), c_int(15), Rgba(105, 133, 158, 255));
        title_width := integer(MeasureText("Free Simula 1.6.1 + raylib 5.5+", c_int(14)));
        DrawText("Free Simula 1.6.1 + raylib 5.5+", c_int((ScreenWidth - title_width) // 2), c_int(560), c_int(14), Rgba(72, 96, 121, 255));
        EndDrawing();
        return
    end;

    i := 1;
    while i <= MaxParticles do
    begin
        if particle_active[i] then
        begin
            alpha_scale := particle_life[i] / particle_max_life[i];
            if particle_color_kind[i] = 0 then
                particle_color := Rgba(50, 229, 255, integer(220.0 * alpha_scale))
            else if particle_color_kind[i] = 1 then
                particle_color := Rgba(255, 66, 92, integer(230.0 * alpha_scale))
            else if particle_color_kind[i] = 2 then
                particle_color := Rgba(255, 170, 66, integer(230.0 * alpha_scale))
            else if particle_color_kind[i] = 3 then
                particle_color := Rgba(180, 90, 255, integer(230.0 * alpha_scale))
            else
                particle_color := Rgba(83, 255, 154, integer(230.0 * alpha_scale));

            DrawCircleV(Vec(particle_x[i] + shake_x, particle_y[i] + shake_y),
                        c_float(particle_size[i] * alpha_scale + 0.5), particle_color)
        end;
        i := i + 1
    end;

    i := 1;
    while i <= MaxBullets do
    begin
        if bullet_active[i] then
        begin
            a := Vec(bullet_old_x[i] + shake_x, bullet_old_y[i] + shake_y);
            b := Vec(bullet_x[i] + shake_x, bullet_y[i] + shake_y);
            DrawLineEx(a, b, c_float(5.0), Rgba(35, 210, 255, 110));
            DrawCircleV(b, c_float(4.0), Rgba(207, 252, 255, 255))
        end;
        i := i + 1
    end;

    i := 1;
    while i <= MaxEnemies do
    begin
        if enemy_active[i] then
        begin
            if enemy_kind[i] = 3 then
            begin
                boss_visible := true;
                boss_hp := enemy_hp[i];
                boss_max_hp := enemy_max_hp[i]
            end;

            if enemy_kind[i] = 0 then
                enemy_color := Rgba(255, 62, 92, 255)
            else if enemy_kind[i] = 1 then
                enemy_color := Rgba(181, 82, 255, 255)
            else if enemy_kind[i] = 2 then
                enemy_color := Rgba(70, 140, 255, 255)
            else
                enemy_color := Rgba(255, 174, 54, 255);

            center := Vec(enemy_x[i] + shake_x, enemy_y[i] + shake_y);
            DrawCircleGradient(c_int(enemy_x[i] + shake_x), c_int(enemy_y[i] + shake_y),
                               c_float(enemy_radius[i] + 8.0), enemy_color, Rgba(20, 10, 26, 20));
            DrawCircleV(center, c_float(enemy_radius[i]), Rgba(13, 16, 27, 255));
            DrawCircleLines(c_int(enemy_x[i] + shake_x), c_int(enemy_y[i] + shake_y),
                            c_float(enemy_radius[i]), enemy_color);

            if enemy_kind[i] = 2 then
            begin
                DrawRing(center, c_float(enemy_radius[i] + 4.0), c_float(enemy_radius[i] + 6.0),
                         c_float(now * 100.0), c_float(now * 100.0 + 220.0),
                         c_int(28), Rgba(110, 185, 255, 190))
            end
            else if enemy_kind[i] = 3 then
            begin
                DrawRing(center, c_float(enemy_radius[i] + 7.0), c_float(enemy_radius[i] + 10.0),
                         c_float(-now * 72.0), c_float(-now * 72.0 + 255.0),
                         c_int(42), Rgba(255, 203, 94, 220));
                DrawRing(center, c_float(enemy_radius[i] + 14.0), c_float(enemy_radius[i] + 16.0),
                         c_float(now * 55.0), c_float(now * 55.0 + 190.0),
                         c_int(42), Rgba(255, 92, 72, 150))
            end;

            if enemy_max_hp[i] > 1 then
            begin
                enemy_hp_width := integer((enemy_radius[i] * 2.0) * real(enemy_hp[i]) / real(enemy_max_hp[i]));
                DrawRectangle(c_int(enemy_x[i] - enemy_radius[i] + shake_x),
                              c_int(enemy_y[i] + enemy_radius[i] + 6.0 + shake_y),
                              c_int(enemy_radius[i] * 2.0), c_int(3), Rgba(35, 29, 47, 220));
                DrawRectangle(c_int(enemy_x[i] - enemy_radius[i] + shake_x),
                              c_int(enemy_y[i] + enemy_radius[i] + 6.0 + shake_y),
                              c_int(enemy_hp_width), c_int(3), enemy_color)
            end
        end;
        i := i + 1
    end;

    if boss_visible then
    begin
        panel := Rect(430.0, 126.0, 420.0, 34.0);
        DrawRectangleRounded(panel, c_float(0.18), c_int(10), Rgba(8, 12, 23, 230));
        DrawRectangle(c_int(442), c_int(149), c_int(396), c_int(5), Rgba(52, 35, 37, 255));
        DrawRectangle(c_int(442), c_int(149), c_int(integer(396.0 * real(boss_hp) / real(boss_max_hp))), c_int(5), Rgba(255, 153, 59, 255));
        DrawText("RIFT TITAN", c_int(574), c_int(132), c_int(15), Rgba(255, 205, 111, 255))
    end;

    if core_active then
    begin
        pulse := 1.0 + Sin(core_phase) * 0.16;
        center := Vec(core_x + shake_x, core_y + shake_y);
        DrawCircleGradient(c_int(core_x + shake_x), c_int(core_y + shake_y),
                           c_float(24.0 * pulse), Rgba(61, 255, 142, 170), Rgba(16, 50, 35, 0));
        DrawRing(center, c_float(12.0 * pulse), c_float(16.0 * pulse),
                 c_float(core_phase * 40.0), c_float(core_phase * 40.0 + 280.0),
                 c_int(24), Rgba(108, 255, 173, 255))
    end;

    aim_len := Root(aim_x * aim_x + aim_y * aim_y);
    if aim_len < 0.001 then aim_len := 1.0;
    nx := aim_x / aim_len;
    ny := aim_y / aim_len;

    center := Vec(player_x + shake_x, player_y + shake_y);
    if hurt_time > 0.0 then
        DrawCircleGradient(c_int(player_x + shake_x), c_int(player_y + shake_y), c_float(31.0),
                           Rgba(255, 177, 83, 190), Rgba(255, 70, 70, 0))
    else
        DrawCircleGradient(c_int(player_x + shake_x), c_int(player_y + shake_y), c_float(30.0),
                           Rgba(49, 225, 255, 170), Rgba(20, 63, 92, 0));

    if dash_time > 0.0 then
        DrawRing(center, c_float(20.0), c_float(27.0), c_float(0.0), c_float(360.0),
                 c_int(36), Rgba(153, 246, 255, 190));

    dx := nx * 22.0;
    dy := ny * 22.0;
    a := Vec(player_x + dx + shake_x, player_y + dy + shake_y);
    b := Vec(player_x - ny * 11.0 - nx * 11.0 + shake_x,
             player_y + nx * 11.0 - ny * 11.0 + shake_y);
    c := Vec(player_x + ny * 11.0 - nx * 11.0 + shake_x,
             player_y - nx * 11.0 - ny * 11.0 + shake_y);
    DrawTriangle(a, b, c, Rgba(202, 250, 255, 255));
    DrawCircleLines(c_int(player_x + shake_x), c_int(player_y + shake_y),
                    c_float(18.0), Rgba(54, 228, 255, 255));

    panel := Rect(20.0, 18.0, 350.0, 91.0);
    DrawRectangleRounded(panel, c_float(0.18), c_int(10), Rgba(8, 12, 23, 225));
    DrawRectangleRoundedLinesEx(panel, c_float(0.18), c_int(10), c_float(1.5), Rgba(44, 88, 118, 220));
    DrawText("RIFTLINE", c_int(38), c_int(31), c_int(22), Rgba(198, 247, 255, 255));
    DrawText(TextFormat("WAVE %02i", c_int(wave)), c_int(38), c_int(60), c_int(18), Rgba(78, 215, 255, 255));
    DrawText(TextFormat("SCORE %08i", c_int(score)), c_int(151), c_int(60), c_int(18), Rgba(226, 238, 247, 255));

    hp_width := integer(300.0 * real(health) / real(max_health));
    DrawRectangle(c_int(38), c_int(87), c_int(300), c_int(8), Rgba(38, 31, 44, 255));
    if health > 35 then
        DrawRectangle(c_int(38), c_int(87), c_int(hp_width), c_int(8), Rgba(64, 240, 151, 255))
    else
        DrawRectangle(c_int(38), c_int(87), c_int(hp_width), c_int(8), Rgba(255, 75, 92, 255));

    panel := Rect(real(ScreenWidth) - 265.0, 18.0, 245.0, 91.0);
    DrawRectangleRounded(panel, c_float(0.18), c_int(10), Rgba(8, 12, 23, 225));
    DrawRectangleRoundedLinesEx(panel, c_float(0.18), c_int(10), c_float(1.5), Rgba(44, 88, 118, 220));
    DrawText(TextFormat("COMBO x%i", c_int(1 + combo // 5)),
             c_int(ScreenWidth - 247), c_int(33), c_int(20),
             Rgba(255, 191, 74, 255));
    DrawText(TextFormat("KILLS %i  TITANS %i", c_int(total_kills), c_int(bosses_killed)),
             c_int(ScreenWidth - 247), c_int(62), c_int(15),
             Rgba(205, 220, 234, 255));
    if dash_wait <= 0.0 then
        DrawText("DASH READY", c_int(ScreenWidth - 247), c_int(84), c_int(15), Rgba(83, 255, 168, 255))
    else
        DrawText("DASH RECHARGING", c_int(ScreenWidth - 247), c_int(84), c_int(15), Rgba(117, 132, 153, 255));

    DrawText("WASD move   mouse aim   LMB fire   SPACE dash   P pause",
             c_int(24), c_int(ScreenHeight - 31), c_int(16), Rgba(92, 113, 135, 220));
    DrawFPS(c_int(ScreenWidth - 92), c_int(ScreenHeight - 29));

    if upgrade_pending and (not game_over) then
    begin
        DrawRectangle(c_int(0), c_int(0), c_int(ScreenWidth), c_int(ScreenHeight), Rgba(3, 5, 12, 205));
        title_width := integer(MeasureText("SIGNAL UPGRADE", c_int(46)));
        DrawText("SIGNAL UPGRADE", c_int((ScreenWidth - title_width) // 2), c_int(165), c_int(46), Rgba(204, 250, 255, 255));
        DrawText(TextFormat("wave %i cleared - choose one", c_int(wave - 1)), c_int(494), c_int(225), c_int(19), Rgba(101, 193, 226, 255));

        panel := Rect(205.0, 300.0, 260.0, 178.0);
        DrawRectangleRounded(panel, c_float(0.12), c_int(8), Rgba(9, 16, 29, 245));
        DrawRectangleRoundedLinesEx(panel, c_float(0.12), c_int(8), c_float(2.0), Rgba(55, 215, 255, 210));
        DrawText("[1] OVERCLOCK", c_int(235), c_int(326), c_int(22), Rgba(102, 233, 255, 255));
        DrawText("faster fire cycle", c_int(235), c_int(366), c_int(17), Rgba(165, 186, 204, 255));
        DrawText(TextFormat("level %i", c_int(fire_level)), c_int(235), c_int(414), c_int(16), Rgba(95, 138, 166, 255));

        panel := Rect(510.0, 300.0, 260.0, 178.0);
        DrawRectangleRounded(panel, c_float(0.12), c_int(8), Rgba(9, 16, 29, 245));
        DrawRectangleRoundedLinesEx(panel, c_float(0.12), c_int(8), c_float(2.0), Rgba(111, 112, 255, 210));
        DrawText("[2] PHASE DRIVE", c_int(540), c_int(326), c_int(22), Rgba(171, 166, 255, 255));
        DrawText("higher move speed", c_int(540), c_int(366), c_int(17), Rgba(165, 186, 204, 255));
        DrawText(TextFormat("level %i", c_int(move_level)), c_int(540), c_int(414), c_int(16), Rgba(95, 138, 166, 255));

        panel := Rect(815.0, 300.0, 260.0, 178.0);
        DrawRectangleRounded(panel, c_float(0.12), c_int(8), Rgba(9, 16, 29, 245));
        DrawRectangleRoundedLinesEx(panel, c_float(0.12), c_int(8), c_float(2.0), Rgba(255, 161, 68, 210));
        DrawText("[3] HARDLIGHT", c_int(845), c_int(326), c_int(22), Rgba(255, 194, 96, 255));
        DrawText("damage + hull capacity", c_int(845), c_int(366), c_int(17), Rgba(165, 186, 204, 255));
        DrawText(TextFormat("level %i", c_int(damage_level)), c_int(845), c_int(414), c_int(16), Rgba(95, 138, 166, 255))
    end;

    if paused and (not game_over) then
    begin
        DrawRectangle(c_int(0), c_int(0), c_int(ScreenWidth), c_int(ScreenHeight), Rgba(3, 5, 10, 170));
        title_width := integer(MeasureText("PAUSED", c_int(48)));
        DrawText("PAUSED", c_int((ScreenWidth - title_width) // 2), c_int(290), c_int(48), Rgba(210, 247, 255, 255));
        DrawText("press P to return", c_int(548), c_int(354), c_int(20), Rgba(111, 183, 210, 255))
    end;

    if game_over then
    begin
        DrawRectangle(c_int(0), c_int(0), c_int(ScreenWidth), c_int(ScreenHeight), Rgba(4, 5, 10, 205));
        title_width := integer(MeasureText("SIGNAL LOST", c_int(54)));
        DrawText("SIGNAL LOST", c_int((ScreenWidth - title_width) // 2), c_int(250), c_int(54), Rgba(255, 80, 104, 255));
        DrawText(TextFormat("score %i   best %i", c_int(score), c_int(best_score)),
                 c_int(474), c_int(324), c_int(22), Rgba(213, 227, 239, 255));
        DrawText(TextFormat("wave %i   kills %i   titans %i", c_int(wave), c_int(total_kills), c_int(bosses_killed)),
                 c_int(474), c_int(356), c_int(18), Rgba(143, 171, 194, 255));
        DrawText("press R to reboot", c_int(523), c_int(402), c_int(22), Rgba(68, 225, 255, 255))
    end;

    EndDrawing()
end;

begin
    real dt;

    assert(c_sizeof(Vector2) = c_size(8));
    assert(c_sizeof(Rectangle) = c_size(16));
    assert(c_sizeof(Color) = c_size(4));

    SetConfigFlags(c_uint(FlagMsaa4x));
    InitWindow(c_int(ScreenWidth), c_int(ScreenHeight), "RIFTLINE - Free Simula + raylib");
    SetTargetFPS(c_int(144));

    outtext("riftline: entering state initialization");
    outimage;
    Init();
    outtext("riftline: state initialized");
    outimage;

    while WindowShouldClose() = c_bool(0) do
    begin
        dt := real(GetFrameTime());
        if dt > 0.05 then dt := 0.05;
        Update(dt);
        Draw()
    end;

    CloseWindow();
    exit(0)
end;
