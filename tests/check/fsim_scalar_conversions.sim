program ScalarConversions;

foreign c from "libc.so.6" begin
    function labs(x: c_long): c_long;
end;

integer function round_down(real x);
begin
    return integer(x)
end;

real function widen(integer x);
begin
    return real(x)
end;

begin
    integer i;
    real r;
    boolean b;
    character ch;

    i := integer(3.75);
    r := real(i);
    b := boolean(1);
    ch := character(65);

    assert(i = 3);
    assert(r = 3.0);
    assert(b);
    assert(ch = character(65));
    assert(labs(c_long(-7)) = c_long(7))
end;
