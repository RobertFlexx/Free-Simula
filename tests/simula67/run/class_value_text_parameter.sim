begin
    class Holder(t);
    value t;
    text t;
    begin
        procedure mutate;
        begin
            t.setpos(2);
            t.putchar('X');
        end;
        procedure show;
        begin
            outtext(t);
            outimage;
        end;
    end;

    text original;
    ref(Holder) h;
    original :- copy("abc");
    h :- new Holder(original);
    h.mutate;
    h.show;
    outtext(original);
    outimage;
end;
