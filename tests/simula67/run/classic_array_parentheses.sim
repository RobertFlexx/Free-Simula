program ClassicArrayParentheses;
begin
    integer array values[1:4];
    integer index;
    integer total;
    total := 0;
    for index := 1 step 1 until 4 do
    begin
        values(index) := index * 2;
        total := total + values(index)
    end;
    outint(total);
    outimage;
    exit(0)
end;
