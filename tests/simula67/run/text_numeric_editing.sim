begin
    text a, b, c;
    integer i;
    real r;

    a :- blanks(10);
    a.putint(-42);
    sysout.outtext("[");
    sysout.outtext(a);
    sysout.outtext("]");
    sysout.outimage;

    b :- copy("  -123  ");
    b.setpos(1);
    i := b.getint;
    sysout.outint(i, 0);
    sysout.outimage;

    c :- copy(" 12.5 ");
    c.setpos(1);
    r := c.getreal;
    sysout.outfix(r, 1, 6);
    sysout.outimage
end text numeric editing;
