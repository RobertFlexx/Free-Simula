integer Procedure Sigma(index, first, last, term);
name index, term;
integer index, first, last, term;
begin
    integer total;
    index := first;
    while index <= last do
    begin
        total := total + term;
        index := index + 1
    end;
    Sigma := total
end;

program NameParameter;
begin
    integer i;
    outint(Sigma(i, 1, 3, i), 0)
end;
