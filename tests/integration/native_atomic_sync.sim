program NativeAtomicSync;
begin
    atomic(integer) counter;
    integer previous;

    atomic_store(counter, 10);
    previous := atomic_fetch_add(counter, 5);
    assert(previous = 10);
    assert(atomic_load(counter) = 15);
    assert(atomic_compare_exchange(counter, 15, 21));
    assert(atomic_exchange(counter, 3) = 21);
    assert(atomic_load(counter) = 3);
    outtext("atomic sync ok");
    outimage;
    exit(0)
end;
