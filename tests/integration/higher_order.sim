type Unary = procedure(integer): integer;

integer function Apply(Unary fn, integer value);
begin
    return fn(value)
end;

integer function Triple(integer value);
begin
    return value * 3
end;

Unary function Choose(boolean doubled);
begin
    if doubled then
        return lambda (integer value): integer => value * 2
    else
        return Triple
end;

program HigherOrder;
begin
    Unary twice;
    Unary selected;
    integer first;
    integer second;
    integer third;

    twice := lambda (integer value): integer => value * 2;
    first := Apply(twice, 21);
    second := Apply(Triple, 14);
    selected := Choose(true);
    third := selected(9);

    assert(first = 42);
    assert(second = 42);
    assert(third = 18);
    outint(first + second + third);
    outimage;
    exit(0)
end;
