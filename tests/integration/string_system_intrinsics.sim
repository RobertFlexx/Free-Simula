program StringSystemIntrinsics;
begin
    string value;
    integer parsed;
    value := "alpha";
    assert(value.length = 5);
    assert(value.byte(0) = 'a');
    assert(value.byte(4) = 'a');
    parsed := "-42".to_integer(99);
    assert(parsed = -42);
    parsed := "nope".to_integer(99);
    assert(parsed = 99);
    outtext("string intrinsics ok");
    outimage;
    exit(0)
end;
