foreign c record BigTriple begin
    a: c_ulonglong;
    b: c_ulonglong;
    c: c_ulonglong;
end;

BigTriple function Bump(BigTriple value);
begin
    value.a := value.a + c_ulonglong(1);
    value.b := value.b + c_ulonglong(2);
    value.c := value.c + c_ulonglong(3);
    return value
end;

program NativeBigCRecord;
begin
    BigTriple value;
    value.a := c_ulonglong(100);
    value.b := c_ulonglong(200);
    value.c := c_ulonglong(300);
    value := Bump(value);
    assert(value.a = c_ulonglong(101));
    assert(value.b = c_ulonglong(202));
    assert(value.c = c_ulonglong(303));
    exit(0)
end;
