program ProgramGlobalState;

boolean ready;
integer count;
array[1:3] integer values;

procedure Mutate;
begin
    ready := true;
    count := count + 7;
    values[2] := count
end;

begin
    ready := false;
    count := 5;
    values[1] := 1;
    values[2] := 0;
    values[3] := 3;
    Mutate();
    if ready and (count = 12) and (values[2] = 12) and
       (values[1] = 1) and (values[3] = 3) then
        outtext("program globals ok")
    else
        outtext("program globals broken");
    outimage
end;
