type Unary = procedure(integer): integer;

Unary function Pick(boolean use_it);
begin
    if use_it then
        return lambda (integer value): integer => value * 2
    else
        return lambda (integer value): integer => value * 3
end;

program HigherOrderReturnLambda;
begin
    Unary selected;
    selected := Pick(true);
    assert(selected(21) = 42);
    exit(0)
end;
