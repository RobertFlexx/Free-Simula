program NativeAtomicCompareExchange;
begin
    atomic(integer) counter;

    atomic_store(counter, 15);
    assert(atomic_compare_exchange(counter, 15, 21));
    assert(atomic_load(counter) = 21);
    assert(not atomic_compare_exchange(counter, 15, 99));
    assert(atomic_load(counter) = 21);
    exit(0)
end;
