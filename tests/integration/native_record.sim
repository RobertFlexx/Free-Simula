type Pair = record
    left: integer;
    right: integer
end;

Pair function MakePair(integer left, integer right);
begin
    Pair result;
    result.left := left;
    result.right := right;
    return result
end;

Pair function SwapPair(Pair pair);
begin
    Pair result;
    result.left := pair.right;
    result.right := pair.left;
    return result
end;

program NativeRecord;
begin
    Pair pair;

    pair := MakePair(17, 25);
    assert(pair.left = 17);
    assert(pair.right = 25);

    pair := SwapPair(pair);
    assert(pair.left = 25);
    assert(pair.right = 17);
    exit(0)
end;
