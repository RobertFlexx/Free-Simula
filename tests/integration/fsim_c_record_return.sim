foreign c record TinyPair begin
    left: c_int;
    right: c_int;
end;

TinyPair function MakePair(integer a, integer b);
begin
    TinyPair pair;
    pair.left := c_int(a);
    pair.right := c_int(b);
    return pair
end;

TinyPair function SwapPair(TinyPair value);
begin
    TinyPair swapped;
    swapped.left := value.right;
    swapped.right := value.left;
    return swapped
end;

begin
    TinyPair pair;

    pair := MakePair(17, 25);
    assert(pair.left = c_int(17));
    assert(pair.right = c_int(25));

    pair := SwapPair(pair);
    assert(pair.left = c_int(25));
    assert(pair.right = c_int(17));
    exit(0)
end;
