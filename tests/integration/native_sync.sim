program NativeSync;
begin
    atomic(integer) counter;
    mutex guard;
    semaphore gate;
    barrier rendezvous;
    integer previous;

    atomic_store(counter, 10);
    previous := atomic_fetch_add(counter, 5);
    assert(previous = 10);
    assert(atomic_load(counter) = 15);
    assert(atomic_compare_exchange(counter, 15, 21));
    assert(atomic_exchange(counter, 3) = 21);

    assert(mutex_try_lock(guard));
    unlock guard;
    synchronized begin
        atomic_fetch_add(counter, 4)
    end;

    semaphore_init(gate, 1);
    assert(semaphore_try_wait(gate));
    assert(not semaphore_try_wait(gate));
    semaphore_post(gate);
    semaphore_wait(gate);

    barrier_init(rendezvous, 1);
    assert(barrier_wait(rendezvous));
    assert(atomic_load(counter) = 7);
    outtext("native sync ok");
    outimage;
    exit(0)
end;
