Class GarbageNode;
begin
    integer value;
end;

procedure MakeGarbage(integer count);
begin
    integer index;
    Ref(GarbageNode) item;
    for index := 1 step 1 until count do
    begin
        item :- new GarbageNode();
        item.value := index
    end
end;

program GarbageCollection;
begin
    integer beforeCount;
    integer afterCount;
    integer reclaimed;

    beforeCount := gc_collection_count();
    MakeGarbage(50000);
    reclaimed := gc_collect();
    afterCount := gc_collection_count();

    assert(afterCount > beforeCount);
    assert(reclaimed > 0);
    assert(gc_reclaimed_bytes() >= reclaimed);
    exit(0)
end;
