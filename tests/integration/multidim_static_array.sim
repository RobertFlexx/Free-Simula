program MultiDimStaticArray;
begin
    integer array board[1:2, 1:3];
    integer i, j, total;
    total := 0;
    for i := 1 step 1 until 2 do
        for j := 1 step 1 until 3 do
        begin
            board(i, j) := i * 10 + j;
            total := total + board(i, j)
        end;
    assert(total = 102);
    outint(total);
    outimage;
    exit(0)
end;
