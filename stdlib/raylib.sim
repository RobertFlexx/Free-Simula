Vector2 function Vec2(real x, real y);
begin
    Vector2 value;
    value.x := c_float(x);
    value.y := c_float(y);
    return value
end;

Vector3 function Vec3(real x, real y, real z);
begin
    Vector3 value;
    value.x := c_float(x);
    value.y := c_float(y);
    value.z := c_float(z);
    return value
end;

Rectangle function Rect(real x, real y, real width, real height);
begin
    Rectangle value;
    value.x := c_float(x);
    value.y := c_float(y);
    value.width := c_float(width);
    value.height := c_float(height);
    return value
end;

Color function Rgba(integer red, integer green, integer blue, integer alpha);
begin
    Color value;
    value.r := c_uchar(red);
    value.g := c_uchar(green);
    value.b := c_uchar(blue);
    value.a := c_uchar(alpha);
    return value
end;

Color function RayWhite;
begin
    return Rgba(245, 245, 245, 255)
end;

Color function White;
begin
    return Rgba(255, 255, 255, 255)
end;

Color function Black;
begin
    return Rgba(0, 0, 0, 255)
end;
