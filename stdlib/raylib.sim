const integer CAMERA_FREE = 1;
const integer CAMERA_ORBITAL = 2;
const integer CAMERA_FIRST_PERSON = 3;
const integer CAMERA_THIRD_PERSON = 4;
const integer CAMERA_PERSPECTIVE = 0;
const integer CAMERA_ORTHOGRAPHIC = 1;

foreign c record Vector2 begin
    x: c_float;
    y: c_float;
end;

foreign c record Vector3 begin
    x: c_float;
    y: c_float;
    z: c_float;
end;

foreign c record Vector4 begin
    x: c_float;
    y: c_float;
    z: c_float;
    w: c_float;
end;

foreign c record Matrix begin
    m0: c_float; m4: c_float; m8: c_float; m12: c_float;
    m1: c_float; m5: c_float; m9: c_float; m13: c_float;
    m2: c_float; m6: c_float; m10: c_float; m14: c_float;
    m3: c_float; m7: c_float; m11: c_float; m15: c_float;
end;

foreign c record Color begin
    r: c_uchar;
    g: c_uchar;
    b: c_uchar;
    a: c_uchar;
end;

foreign c record Rectangle begin
    x: c_float;
    y: c_float;
    width: c_float;
    height: c_float;
end;

foreign c record Image begin
    data: c_ptr(c_void);
    width: c_int;
    height: c_int;
    mipmaps: c_int;
    format: c_int;
end;

foreign c record Texture2D begin
    id: c_uint;
    width: c_int;
    height: c_int;
    mipmaps: c_int;
    format: c_int;
end;

foreign c record RenderTexture2D begin
    id: c_uint;
    texture: Texture2D;
    depth: Texture2D;
end;

foreign c record GlyphInfo begin
    value: c_int;
    offsetX: c_int;
    offsetY: c_int;
    advanceX: c_int;
    image: Image;
end;

foreign c record Font begin
    baseSize: c_int;
    glyphCount: c_int;
    glyphPadding: c_int;
    texture: Texture2D;
    recs: c_ptr(Rectangle);
    glyphs: c_ptr(GlyphInfo);
end;

foreign c record Camera2D begin
    offset: Vector2;
    target: Vector2;
    rotation: c_float;
    zoom: c_float;
end;

foreign c record Camera3D begin
    position: Vector3;
    target: Vector3;
    up: Vector3;
    fovy: c_float;
    projection: c_int;
end;

foreign c record Shader begin
    id: c_uint;
    locs: c_ptr(c_int);
end;

foreign c record Ray begin
    position: Vector3;
    direction: Vector3;
end;

foreign c record RayCollision begin
    hit: c_bool;
    distance: c_float;
    point: Vector3;
    normal: Vector3;
end;

foreign c record BoundingBox begin
    minimum: Vector3;
    maximum: Vector3;
end;

foreign c record Wave begin
    frameCount: c_uint;
    sampleRate: c_uint;
    sampleSize: c_uint;
    channels: c_uint;
    data: c_ptr(c_void);
end;

foreign c opaque record RayAudioBuffer;
foreign c opaque record RayAudioProcessor;

foreign c record AudioStream begin
    buffer: c_ptr(RayAudioBuffer);
    processor: c_ptr(RayAudioProcessor);
    sampleRate: c_uint;
    sampleSize: c_uint;
    channels: c_uint;
end;

foreign c record Sound begin
    stream: AudioStream;
    frameCount: c_uint;
end;

foreign c record Music begin
    stream: AudioStream;
    frameCount: c_uint;
    looping: c_bool;
    ctxType: c_int;
    ctxData: c_ptr(c_void);
end;

