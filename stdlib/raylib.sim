module Raylib;

const integer RAYLIB_VERSION_MAJOR = 6;
const integer RAYLIB_VERSION_MINOR = 0;
const integer RAYLIB_VERSION_PATCH = 0;

const integer FLAG_VSYNC_HINT = 64;
const integer FLAG_FULLSCREEN_MODE = 2;
